FROM radixark/vllm-glm53-flash:sm121-v6

# Indexer hardening (second NaN class): top-k destination was torch.empty and
# the top-k kernels only guarantee the first min(k, valid) entries; rows with
# fewer valid pools carried uninitialized pool ids -> bogus token indices ->
# MLA gathers uninitialized KV -> NaN lottery. Init to -1 + clamp expansion.
COPY patch_v7.py /tmp/patch_v7.py
RUN python3 /tmp/patch_v7.py && rm /tmp/patch_v7.py
